# Copier en .env.local. Valeurs locales : `pnpm supabase status` après `pnpm supabase start`.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Connexion Google : « true » une fois le fournisseur configuré dans Supabase (docs/DEPLOYMENT.md).
# Absent, seul le lien magique est proposé.
# NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true

# Supabase (serveur uniquement, contourne la RLS)
SUPABASE_SECRET_KEY=

# Anthropic (serveur uniquement)
ANTHROPIC_API_KEY=

# Surcharges facultatives des modèles (voir src/lib/ai/models.ts)
# MODEL_SCRIPT_STANDARD=claude-sonnet-5-5
# MODEL_SCRIPT_PREMIUM=claude-opus-5-5
# MODEL_LIGHT=claude-haiku-5-5

# Disjoncteur de dépense LLM, en dollars par jour UTC (facultatif : 200 et 25 par défaut).
# SPEND_DAILY_LIMIT_USD=200
# SPEND_DAILY_WORKSPACE_LIMIT_USD=25

# URL publique du site (Open Graph, sitemap, robots). Sur Vercel, le domaine de production par défaut.
# NEXT_PUBLIC_SITE_URL=https://pipeline-ai.example

# PostHog (funnel, côté serveur). Absent : rien n'est envoyé. Projet en région UE.
# POSTHOG_KEY=phc_
# POSTHOG_HOST=https://eu.i.posthog.com

# Case à cocher des CGU dans Stripe Checkout, une fois leur URL renseignée dans le Dashboard
# Stripe (docs/runbook.md, §1.3). Vérification avant lancement : pnpm preflight <fichier d'env>.
# STRIPE_TERMS_CONSENT=required

# Administration (/admin) : adresses séparées par des virgules. Absent, la page est fermée à tous.
# ADMIN_EMAILS=
# Marge par pipeline : conversion des coûts LLM (dollars) en euros (0,92 par défaut).
# USD_TO_EUR=0.92

# Sentry (facultatif : absent, Sentry reste désactivé). Le DSN n'est pas un secret.
# NEXT_PUBLIC_SENTRY_DSN=
# Build seulement, pour envoyer les source maps (Vercel) :
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Inngest. En local : `INNGEST_DEV=1` et `npx inngest-cli@latest dev`.
# Sur Vercel, posées par l'intégration Inngest et obligatoires (le build échoue sans elles).
# INNGEST_DEV=1
# INNGEST_SIGNING_KEY=
# INNGEST_EVENT_KEY=

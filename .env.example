# Copier en .env.local. Valeurs locales : `pnpm supabase status` après `pnpm supabase start`.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (serveur uniquement, contourne la RLS)
SUPABASE_SECRET_KEY=

# Anthropic (serveur uniquement)
ANTHROPIC_API_KEY=

# Surcharges facultatives des modèles (voir src/lib/ai/models.ts)
# MODEL_SCRIPT_STANDARD=claude-sonnet-5-5
# MODEL_SCRIPT_PREMIUM=claude-opus-5-5
# MODEL_LIGHT=claude-haiku-5-5
